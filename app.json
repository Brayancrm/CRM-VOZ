{
  "expo": {
    "name": "SeCretina",
    "slug": "secretina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "secretina",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koomind.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O SeCretina usa o microfone para ouvir comandos de voz e notas.",
        "NSContactsUsageDescription": "Importar e associar contatos às suas notas.",
        "NSCalendarsUsageDescription": "Exibir compromissos do calendário junto com ligações agendadas no app.",
        "NSSpeechRecognitionUsageDescription": "O SeCretina usa reconhecimento de voz para criar notas por comando falado."
      }
    },
    "android": {
      "package": "com.koomind.app",
      "label": "SeCretina",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "POST_NOTIFICATIONS",
        "READ_PHONE_STATE",
        "READ_CALL_LOG",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "MODIFY_AUDIO_SETTINGS",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "USE_FULL_SCREEN_INTENT",
        "BLUETOOTH_CONNECT",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "lembretes-ligacao"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permitir acesso aos contatos para importar ao SeCretina."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Permitir acesso ao calendário para exibir compromissos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Gravar nota de voz manual (opcional)."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O SeCretina usa o microfone para ouvir seus comandos de voz.",
          "speechRecognitionPermission": "O SeCretina usa reconhecimento de voz para criar notas por comando.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "./plugins/withAndroidManifestMerge.js",
      "./plugins/withKoomindCallRecording.js",
      "./plugins/withKoomindHelper.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
