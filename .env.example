# URL pública do Railway — embutida no APK no momento do build.
# O utilizador NÃO configura isto nos Ajustes.
# Serve para: Whisper, TTS SeCretina e interpretação GPT.
# A chave OpenAI (sk-…) fica SÓ no Railway (OPENAI_API_KEY), nunca aqui.
EXPO_PUBLIC_TRANSCRIPTION_API_URL=https://seu-projeto.up.railway.app

# Mesmo valor de API_SECRET no Railway (recomendado).
# Também vai no build — não é a chave OpenAI.
EXPO_PUBLIC_TRANSCRIPTION_API_SECRET=
